{
  "name": "ttt-browser-extension",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "addfox dev -b edge --keep-browser-profile",
    "build": "addfox build --no-open",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "node scripts/patch-addfox-bin.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "addfox": "^0.2.9",
    "bun-types": "^1.4.4",
    "jsdom": "^31.0.0",
    "linkedom": "^0.18.15",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
